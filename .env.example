# Connect to Supabase via Shared Connection Pooler
# Supabase Dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL: Pooled connection (pgBouncer üzerinden, uygulama sorguları için)
# Transaction mode: port 6543, ?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Doğrudan bağlantı (Prisma migrate için, pgBouncer bypass)
# Session mode: port 5432, pgbouncer parametresi olmadan
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Prisma bağlantı havuzu (opsiyonel — kodda varsayılanı var, bkz. lib/db/prisma.ts)
# Prisma varsayılanı `cpu*2+1` = Vercel'de 5 bağlantıdır ve eşzamanlı istek
# dalgasında P2024 ("connection pool timeout") hatası verir. Supavisor istemci
# bağlantılarını ucuza çoğulladığı için bu değeri yükseltmek güvenlidir.
# PRISMA_CONNECTION_LIMIT=12
# PRISMA_POOL_TIMEOUT=20

# Auth (next-auth v5)
AUTH_SECRET="generate-with: node -e \"require('crypto').randomBytes(32).toString('base64')\""

# App
NEXT_PUBLIC_SITE_URL="https://halfleafstore.com"

# OpenAI (AI görsel dönüştürme için)
OPENAI_API_KEY=sk-...

# ─── PayTR iFrame API (Ödeme) ───
# Değerler: PayTR Mağaza Paneli → BİLGİ sayfası (Ana Kullanıcı / Teknik Sorumlu görebilir)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# Test modu: "1" = test (canlı modda dahi tahsilat YAPILMAZ), "0" = gerçek tahsilat.
# Entegrasyon/test sürecinde 1 bırakın; canlıya geçince 0 yapın.
PAYTR_TEST_MODE=1

# Taksit ayarları (opsiyonel):
#   PAYTR_NO_INSTALLMENT=1  → taksit gizlenir, yalnızca tek çekim
#   PAYTR_MAX_INSTALLMENT=0 → izin verilen en yüksek taksit (0 = sınırsız)
PAYTR_NO_INSTALLMENT=0
PAYTR_MAX_INSTALLMENT=0

# ÖNEMLİ: PayTR Mağaza Paneli → Ayarlar → Bildirim URL alanına şunu girin:
#   https://halfleafstore.com/api/odeme/paytr/callback

# ─── E-posta Bildirimleri (opsiyonel — Resend) ───
# Tanımlıysa sipariş onay ve kargo bildirimi e-postaları gönderilir; yoksa sessizce atlanır.
# Resend (resend.com) ücretsiz katman + doğrulanmış gönderen alan adı gerekir.
RESEND_API_KEY=
EMAIL_FROM="Half Leaf <siparis@halfleafstore.com>"
# Yeni üye hoş geldin e-postasında gösterilecek indirim kodu (opsiyonel).
# Admin panelden bu kodda bir kupon oluşturmayı unutmayın.
WELCOME_DISCOUNT_CODE=

# ─── Rate Limiting (opsiyonel ama önerilir) ───
# Tanımlıysa serverless'ta paylaşılan/güvenilir rate limiting (Upstash Redis REST) aktif olur;
# tanımlı değilse in-memory limiter kullanılır (tek instance'ta çalışır). Upstash ücretsiz katman yeterli.
# Vercel Marketplace üzerinden Upstash bağlanırsa değişkenler KV_REST_API_URL /
# KV_REST_API_TOKEN adıyla otomatik enjekte edilir; kod ikisini de kabul eder.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
